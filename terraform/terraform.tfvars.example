# Copy to terraform.tfvars and adjust. Never put AWS keys in this file:
# Terraform reads credentials from your AWS profile / environment.
aws_region          = "ap-south-1"
project             = "clinicdesk"
environment         = "dev"
cluster_name        = "clinicdesk-eks"
vpc_cidr            = "10.42.0.0/16"
node_instance_types = ["t3.medium"]
node_min_size       = 1
node_desired_size   = 2
node_max_size       = 3
